{
  "model_name": "Blue-Eye",
  "architecture": "BlueEyeClassifier",
  "task": "image-classification",
  "format_version": 1,
  "num_labels": 3,
  "id2label": {
    "0": "safe",
    "1": "suggestive",
    "2": "explicit"
  },
  "label2id": {
    "safe": 0,
    "suggestive": 1,
    "explicit": 2
  },
  "backbone": "facebook/dinov3-vitl16-pretrain-lvd1689m",
  "backbone_config": {
    "model_type": "dinov3_vit",
    "attention_dropout": 0.0,
    "drop_path_rate": 0.0,
    "hidden_act": "gelu",
    "hidden_size": 1024,
    "image_size": 224,
    "initializer_range": 0.02,
    "intermediate_size": 4096,
    "key_bias": false,
    "layer_norm_eps": 1e-05,
    "layerscale_value": 1.0,
    "mlp_bias": true,
    "num_attention_heads": 16,
    "num_channels": 3,
    "num_hidden_layers": 24,
    "num_register_tokens": 4,
    "patch_size": 16,
    "pos_embed_jitter": null,
    "pos_embed_rescale": 2.0,
    "pos_embed_shift": null,
    "proj_bias": true,
    "query_bias": true,
    "rope_theta": 100.0,
    "use_gated_mlp": false,
    "value_bias": true
  },
  "attn_implementation": "sdpa",
  "pooling": "concat(final CLS token, mean of all other final tokens incl. the 4 register tokens)",
  "head": {
    "type": "layernorm_linear",
    "in_features": 2048,
    "layer_norm_eps": 1e-05,
    "dtype": "float32"
  },
  "preprocessing": {
    "color_mode": "RGB",
    "resize_shortest_edge": 537,
    "resample": "bicubic",
    "crop_size": 512,
    "rescale_factor": 0.00392156862745098,
    "image_mean": [0.485, 0.456, 0.406],
    "image_std": [0.229, 0.224, 0.225]
  },
  "weights_dtype": "float32"
}
